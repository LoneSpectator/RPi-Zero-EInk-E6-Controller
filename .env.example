# Copy to .env; never commit your password.
IMAGE=ghcr.io/lonespectator/rpi-zero-eink-e6-controller:latest
TZ=Asia/Shanghai
WEB_USERNAME=admin
# Unset or empty disables authentication; set a password to enable it.
WEB_PASSWORD=
# Set 0.0.0.0 to allow LAN connections.
BIND_ADDRESS=127.0.0.1
INA219_ADDRESS=0x43
# PhotoPainter raw current is negative on battery power; normalize for the model.
INA219_CURRENT_POLARITY=-1
